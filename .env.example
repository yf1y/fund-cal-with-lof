# Optional. Without this value the app reads the bundled 21-fund data.json file.
# For Supabase on an IPv4 host such as Render, copy the Session Pooler connection string.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Local development only. Set to 1 if you want Uvicorn auto-reload.
RELOAD=0
