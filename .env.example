# Optional locally; recommended on Render so query history survives deploys and sleep.
# Copy the Supabase Session Pooler connection string and URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Local development only. Set to 1 if you want Uvicorn auto-reload.
RELOAD=0
